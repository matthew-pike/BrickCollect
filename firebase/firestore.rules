rules_version = '2';
// BrickCollect database rules: the same access as the Supabase setup.
//  - Shared data (prices, BrickLink numbers, subthemes and tags, other brands, exchange rates):
//    anyone can read; only admins can change it from the site.
//  - Each person's collection: only that person can read or change it.
//  - Usage numbers (admin/usage): only admins can read them; nobody can write them from the site.
//  - Admin list and job bookkeeping: never readable or writable from the site.
// The scheduled jobs use the Admin SDK, which is not limited by these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Admins are listed by lower-case email in /admins/{email}; the email must be verified
    // (Google sign-in and email-link sign-in both verify it).
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // Account types: anyone listed in /admins is a super admin, unless their entry has role: 'admin'.
    // Everyone else is a user. Super admins can do everything; admins and users get what's ticked in
    // meta/permissions ({ admin: { items: true, … }, user: { … } }), set on the Admin page by a super admin.
    function staffEntry() { return get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())); }
    function isSuper() { return isAdmin() && staffEntry().data.get('role', 'super') != 'admin'; }
    function roleName() { return isAdmin() ? 'admin' : 'user'; }
    function can(p) {
      return isSuper() || (signedIn() && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/meta/permissions)
        && get(/databases/$(database)/documents/meta/permissions).data.get(roleName(), {}).get(p, false) == true);
    }

    // items = prices, BrickLink numbers and retired status; subthemes = subthemes, tags and Film / Series;
    // sets = other brands' sets.
    match /iteminfo/{id}  { allow read: if true; allow write: if can('items'); }
    match /subthemes/{id} { allow read: if true; allow write: if can('subthemes'); }
    match /catalog/{id}   { allow read: if true; allow write: if can('sets'); }
    // Only super admins change who can do what; other meta docs (exchange rates) stay with staff.
    match /meta/permissions { allow read: if true; allow write: if isSuper(); }
    match /meta/{id}      { allow read: if true; allow write: if isAdmin() && id != 'permissions'; }

    // Same path the page already uses: data/users/<uid>/collection
    match /data/users/{uid}/{docId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // A signed-in person may look up only their own entry, which is how the page knows you're the admin.
    match /admins/{email} {
      allow get: if signedIn() && request.auth.token.email_verified == true
                 && email == request.auth.token.email.lower();
    }

    // Public sale or trade lists (brickcollect.app/sale/<id>): a copy of what someone chose to share.
    // Anyone with the link can read one (get only: nobody can list them all). Only its owner can create,
    // change or delete it, the owner field can't change hands, and only the known fields fit, with size limits.
    function validShop() {
      let d = request.resource.data;
      // idx: the seller lets search engines find the page (off unless they turn it on).
      return d.keys().hasOnly(['owner', 'v', 'name', 'place', 'ig', 'contact', 'cur', 'items', 'updatedAt', 'idx'])
        && d.get('idx', false) is bool
        && d.owner == request.auth.uid
        && d.items is list && d.items.size() <= 1000
        && d.get('name', '') is string && d.get('name', '').size() <= 40
        && d.get('place', '') is string && d.get('place', '').size() <= 60
        && d.get('ig', '') is string && d.get('ig', '').size() <= 31
        && d.get('contact', '') is string && d.get('contact', '').size() <= 200
        && d.get('cur', '') is string && d.get('cur', '').size() <= 3;
    }
    match /shops/{id} {
      allow get: if true;
      allow create: if signedIn() && validShop();
      allow update: if signedIn() && resource.data.owner == request.auth.uid && validShop();
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }

    // Usage numbers for the owner's Usage page (written hourly by a job; counts only, no emails): admins may read.
    match /admin/{id} { allow get: if can('usage'); }

    // /private (sync counts, job state) has no rule, so the site can't touch it.
    // Anything not matched above is denied.
  }
}
