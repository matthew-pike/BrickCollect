rules_version = '2';
// BrickCollect database rules: the same access as the Supabase setup.
//  - Shared data (prices, BrickLink numbers, subthemes and tags, other brands, exchange rates):
//    anyone can read; only admins can change it from the site.
//  - Each person's collection: only that person can read or change it.
//  - Usage numbers (admin/usage): only admins can read them; nobody can write them from the site.
//  - Admin list and job bookkeeping: never readable or writable from the site.
// The scheduled jobs use the Admin SDK, which is not limited by these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Admins are listed by lower-case email in /admins/{email}; the email must be verified
    // (Google sign-in and email-link sign-in both verify it).
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    match /iteminfo/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /subthemes/{id} { allow read: if true; allow write: if isAdmin(); }
    match /catalog/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /meta/{id}      { allow read: if true; allow write: if isAdmin(); }

    // Same path the page already uses: data/users/<uid>/collection
    match /data/users/{uid}/{docId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // A signed-in person may look up only their own entry, which is how the page knows you're the admin.
    match /admins/{email} {
      allow get: if signedIn() && request.auth.token.email_verified == true
                 && email == request.auth.token.email.lower();
    }

    // Usage numbers for the owner's Usage page (written hourly by a job; counts only, no emails): admins may read.
    match /admin/{id} { allow get: if isAdmin(); }

    // /private (sync counts, job state) has no rule, so the site can't touch it.
    // Anything not matched above is denied.
  }
}
